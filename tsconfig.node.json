{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.mts",
    "vitest.config.mts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/core/**/*",
    "src/shared/**/*",
    "test/**/*"
  ],
  // 界面层（src/renderer）的测试由 tsconfig.web.json 检查
  "exclude": ["test/renderer/**/*"]
}
